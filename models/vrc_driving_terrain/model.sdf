<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="vrc_driving_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://vrc_driving_terrain/materials/textures/heightmap.png</uri>
            <size>500 500 118</size>
            <pos>0 0 -15</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <!-- TEXTURES FIRST (like the original that worked) -->
            <texture>
              <diffuse>model://vrc_driving_terrain/materials/textures/grass_dry.png</diffuse>
              <normal>model://vrc_driving_terrain/materials/textures/flat_normal.png</normal>
              <size>12</size>
            </texture>
            <texture>
              <diffuse>model://vrc_driving_terrain/materials/textures/grass_dry.png</diffuse>
              <normal>model://vrc_driving_terrain/materials/textures/flat_normal.png</normal>
              <size>12</size>
            </texture>
            <texture>
              <diffuse>model://vrc_driving_terrain/materials/textures/grass_dry.png</diffuse>
              <normal>model://vrc_driving_terrain/materials/textures/flat_normal.png</normal>
              <size>12</size>
            </texture>
            <blend>
              <min_height>15</min_height>
              <fade_dist>5</fade_dist>
            </blend>
            <blend>
              <min_height>30</min_height>
              <fade_dist>10</fade_dist>
            </blend>

            <!-- URI/LAYOUT LAST (exactly like the original working model) -->
            <uri>model://vrc_driving_terrain/materials/textures/heightmap.png</uri>
            <size>500 500 118</size>
            <pos>0 0 -15</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>

  </model>
</sdf>
