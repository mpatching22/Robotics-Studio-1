<model name="big_oak_tree">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://big_oak_tree/meshes/big_oak_tree.dae</uri>
            </mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode />
            </contact>
            <bounce />
            <friction>
              <torsional>
                <ode />
              </torsional>
              <ode />
            </friction>
          </surface>
        </collision>
        <visual name="branch">
          <geometry>
            <mesh>
              <uri>model://big_oak_tree/meshes/big_oak_tree.dae</uri>
              <submesh>
                <name>Branch</name>
              </submesh>
            </mesh>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.3 1</ambient><diffuse>0.5 1.0 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <visual name="bark">
          <geometry>
            <mesh>
              <uri>model://big_oak_tree/meshes/big_oak_tree.dae</uri>
              <submesh>
                <name>Bark</name>
              </submesh>
            </mesh>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.3 1</ambient><diffuse>0.5 1.0 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
</sdf>
